# ===========================
# 通用忽略规则
# ===========================

# 编辑器/IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 日志文件
*.log
logs/

# 环境变量文件
.env
.env.local
.env.*.local

# ===========================
# 后端 (C++)
# ===========================

# 编译输出
backend/build/
backend/cmake-build-*/
backend/*.o
backend/*.a
backend/*.so
backend/*.dylib
backend/visitor_system

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json

# 数据文件
backend/data/
*.db
*.db-journal

# ===========================
# 前端通用
# ===========================

# 依赖目录
node_modules/

# 构建输出
dist/
build/

# 缓存
.cache/
.parcel-cache/
.vite/

# 测试覆盖率
coverage/

# ===========================
# 前端管理后台
# ===========================

frontend-admin/node_modules/
frontend-admin/dist/
frontend-admin/.vite/

# ===========================
# 前端用户端
# ===========================

frontend-user/node_modules/
frontend-user/dist/
frontend-user/.vite/

# ===========================
# Docker
# ===========================

# Docker 忽略规则已在各子项目的 .dockerignore 中定义
